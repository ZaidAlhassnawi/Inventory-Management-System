<Window x:Class="InventoryManagementSystem_PresentaionLayer.Supplier.SupplierView.AddEditSupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="500" Width="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="White" CornerRadius="12" BorderThickness="1" BorderBrush="#E5E7EB">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Add a new supplier to your network" Foreground="#6B7280" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <UniformGrid Columns="2" Margin="0,0,0,15">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Supplier Name" FontWeight="Medium" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle2}" Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" Tag="Enter supplier name"/>
                    </StackPanel>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Contact Person" FontWeight="Medium" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle2}" Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Tag="Enter contact person name"/>
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,0,0,15">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Email" FontWeight="Medium" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle2}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Tag="Enter email address"/>
                    </StackPanel>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Phone Number" FontWeight="Medium" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle2}" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Tag="Enter phone number"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Address" FontWeight="Medium" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle2}" Height="100" TextWrapping="Wrap" AcceptsReturn="True" 
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Tag="Enter full address..."
                             />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" Width="100" Height="40" Margin="0,0,12,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

                <Button Content="{Binding ButtonText}" Width="140" Height="40"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>