<Page x:Class="InventoryManagementSystem_PresentaionLayer.Supplier.SupplierView.SupplierWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InventoryManagementSystem_PresentaionLayer.Supplier.SupplierView"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Background="#F3F4F6">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <DockPanel Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Suppliers" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBlack}"/>
                    <TextBlock Text="Manage your supplier relationships and contact information" Foreground="{StaticResource SecondaryGray}"/>
                </StackPanel>
                <Button Content="+ Add Supplier" HorizontalAlignment="Right" Style="{StaticResource AddButtonStyle}"
                        Command="{Binding OpenAddSupplierWindowCommand}"/>
            </DockPanel>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Overview" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#EFF6FF" Padding="10" CornerRadius="8">
                            <Path Data="M20,8H17V4H3C1.89,4 1,4.89 1,6V17H3A3,3 0 0,0 6,20A3,3 0 0,0 9,17H15A3,3 0 0,0 18,20A3,3 0 0,0 21,17H23V12L20,8M6,18.5A1.5,1.5 0 0,1 4.5,17A1.5,1.5 0 0,1 6,15.5A1.5,1.5 0 0,1 7.5,17A1.5,1.5 0 0,1 6,18.5M18,18.5A1.5,1.5 0 0,1 16.5,17A1.5,1.5 0 0,1 18,15.5A1.5,1.5 0 0,1 19.5,17A1.5,1.5 0 0,1 18,18.5M17,12V9.5H19.5L21.47,12H17Z" 
                                  Fill="{StaticResource AccentTextBrush}" Width="24" Height="24" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0">
                            <TextBlock Text="{Binding Count}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Total Suppliers" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Tag="Search suppliers..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="3">
                <StackPanel>
                    <TextBlock Text="{Binding CountString}" Margin="20,20,0,5" FontWeight="Bold"/>
                    <TextBlock Text="Manage supplier information and contact details" Margin="20,0,0,20" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>

                    <Grid Background="White">
                        <DataGrid x:Name="membersDataGrid"
                                  ItemsSource="{Binding FilteredSuppliers}"
                                  Style="{DynamicResource DataGridStyle1}"
                                  RowStyle="{DynamicResource DataGridRowStyle1}"
                                  CellStyle="{DynamicResource DataGridCellStyle1}"
                                  ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}"
                                  RowHeight="60" BorderThickness="0" Background="Transparent" IsReadOnly="True" AutoGenerateColumns="False">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Supplier Name" Binding="{Binding SupplierName}" Width="*"/>

                                <DataGridTemplateColumn Header="Contact Person" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="32" Height="32" CornerRadius="16" Background="#F3F4F6" Margin="0,0,12,0">
                                                    <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                                          Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Text="{Binding ContactPerson}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Email" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4M20,8L12,13L4,8V6L12,11L20,6V8Z" 
                                                      Fill="#3B82F6" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Email}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Phone" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z" 
                                                      Fill="#3B82F6" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding PhoneNumber}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="1.5*"/>
                                <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="1*"/>

                                <DataGridTemplateColumn Header="Actions" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="✏️" Margin="2" Width="30" Height="30" Background="White" BorderBrush="{StaticResource BorderGray}"
                                                        Command="{Binding DataContext.OpenEditSupplierWindowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="🗑️" Margin="2" Width="30" Height="30" Background="White" BorderBrush="{StaticResource BorderGray}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>