<Application x:Class="InventoryManagementSystem_PresentaionLayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:InventoryManagementSystem_PresentaionLayer" 
             xmlns:local1="clr-namespace:InventoryManagementSystem_PresentaionLayer.Global">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ColorsDictionary.xaml"/>
                <ResourceDictionary Source="/Resources/StylesDictionary.xaml"/>
                <ResourceDictionary Source="/Resources/Fonts.xaml"/>
                <ResourceDictionary Source="/Resources/Icons.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
                <ResourceDictionary Source="/Resources/ProductsStyles.xaml"/>
                <ResourceDictionary Source="/Resources/CategoryStyles.xaml"/>
                <ResourceDictionary Source="/Resources/InventoryLogStyle.xaml"/>
                <ResourceDictionary Source="/Resources/AdjustmentsStyle.xaml"/>
                <ResourceDictionary Source="/Resources/SettingsStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local1:PathToImageConverter x:Key="PathToImageConverter"/>
        </ResourceDictionary>
    </Application.Resources>
    
    
</Application>
