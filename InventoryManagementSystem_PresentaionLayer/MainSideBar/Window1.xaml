<Window x:Class="InventoryManagementSystem_PresentaionLayer.MainSideBar.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon ="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:InventoryManagementSystem_PresentaionLayer.MainSideBar"
        mc:Ignorable="d" x:Name="SideBarWindow"
        Title="Inventory System" Height="650" Width="1000" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"  Background="{StaticResource Bg_Main}" FontFamily="{StaticResource Font_Main}">

    <Grid>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Bg_Sidebar}" BorderBrush="{StaticResource Border_Light}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="25,30,0,40">
                    <Path Data="{StaticResource Icon_Products}" Fill="{StaticResource Text_Active}" Width="24" Height="24" Stretch="Uniform"/>
                    <TextBlock Text="Inventory" FontSize="{StaticResource Size_Header}" FontWeight="{StaticResource Weight_Bold}" Foreground="{StaticResource Text_Primary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,0">
                    <RadioButton Content="Dashboard" Tag="{StaticResource Icon_Dashboard}" Style="{StaticResource NavButtonStyle}" IsChecked="True" GroupName="Nav"/>
                    <RadioButton Content="Products" Tag="{StaticResource Icon_Products}" Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                  Command="{Binding OpenProductsCommand}"
                                  CommandParameter="{Binding ElementName=SideBarWindow}"/>
                    <RadioButton Content="Categories" Tag="{StaticResource Icon_Categories}" Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                 Command="{Binding OpenCategoriesCommand}"
                                 CommandParameter="{Binding ElementName=SideBarWindow}"/>
                    <RadioButton Content="Suppliers" Tag="{StaticResource Icon_Suppliers}" Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                 Command="{Binding OpenSupplierCommand}"
                                 CommandParameter="{Binding ElementName=SideBarWindow}"/>
                        <RadioButton Content="Invetory Log" Tag="{StaticResource Icon_Inventory}" Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                  Command="{Binding OpenInventoryLogCommand}"
                                 CommandParameter="{Binding ElementName=SideBarWindow}"/>
                        <RadioButton Content="Reports" Tag="{StaticResource Icon_Reports}" Style="{StaticResource NavButtonStyle}" GroupName="Nav"/>
                    <RadioButton Content="Settings" Tag="{StaticResource Icon_Settings}" Style="{StaticResource NavButtonStyle}" GroupName="Nav"
                                  Command="{Binding OpenSettingsCommand}"
                                 CommandParameter="{Binding ElementName=SideBarWindow}"/>

                </StackPanel>

                <Border Grid.Row="2" Margin="15,0,15,20" Padding="10" Background="{StaticResource Bg_Main}" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16">
                            <Border.Background>
                                <ImageBrush ImageSource="https://i.pravatar.cc/150?img=11"/>
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser.FullName}" FontWeight="{StaticResource Weight_Bold}" FontSize="{StaticResource Size_Small}" Foreground="{StaticResource Text_Primary}"/>
                            <TextBlock Text="{Binding CurrentUser.RoleName}" FontSize="{StaticResource Size_Small}" Foreground="{StaticResource Text_Secondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"  Background="{StaticResource Bg_Sidebar}" BorderBrush="{StaticResource Border_Light}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <TextBlock Text="Inventory Management" FontSize="{StaticResource Size_Header}" FontWeight="{StaticResource Weight_Bold}" VerticalAlignment="Center" Foreground="{StaticResource Text_Primary}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ToggleButton x:Name="UserToggle" Style="{StaticResource ProfileToggleStyle}"/>

                        <Popup IsOpen="{Binding IsChecked, ElementName=UserToggle}"
                               StaysOpen="False"
                               PlacementTarget="{Binding ElementName=UserToggle}"
                               Placement="Bottom"
                               PopupAnimation="Slide"
                               AllowsTransparency="True"
                               VerticalOffset="5"
                               HorizontalOffset="-20">         

                            <Border Margin="0,0,15,15" Background="Transparent">

                                <Border Background="{StaticResource Bg_Sidebar}"
                                    Width="210"
                                    CornerRadius="15"
                                    BorderBrush="{StaticResource Border_Light}"
                                    BorderThickness="1"
                                    Padding="0">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="5" Opacity="0.25" Color="Black" Direction="200"/>
                                    </Border.Effect>

                                    <StackPanel>
                                        <StackPanel Margin="20,15,20,15">
                                            <TextBlock Text="{Binding CurrentUser.FullName}" FontWeight="{StaticResource Weight_Bold}" Foreground="{StaticResource Text_Primary}" FontSize="{StaticResource Size_Regular}"/>
                                            <TextBlock Text="{Binding CurrentUser.Email}" FontSize="{StaticResource Size_Small}" Foreground="{StaticResource Text_Secondary}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding CurrentUser.RoleName, StringFormat=Role: {0}}" FontSize="{StaticResource Size_Small}" Foreground="{StaticResource Text_Secondary}" Margin="0,3,0,0"/>

                                        </StackPanel>

                                        <Separator Background="{StaticResource Border_Light}" Margin="0" Height="1" Opacity="0.6"/>

                                        <StackPanel Margin="5,8">
                                            <Button Content="Profile" Style="{StaticResource PopupButtonStyle}"/>
                                            <Button Content="Settings" Style="{StaticResource PopupButtonStyle}"/>
                                        </StackPanel>

                                        <Separator Background="{StaticResource Border_Light}" Margin="0" Height="1" Opacity="0.6"/>

                                        <StackPanel Margin="5,8">
                                            <Button Content="Log out" Style="{StaticResource PopupButtonStyle}" Foreground="{StaticResource Text_Danger}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Popup>


                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="10" Background="#F9FAFB">
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>
       
    </Grid>
        <Grid x:Name="BackgroundOpasity" Background="#B3000000" Visibility="Collapsed">

        </Grid>
    </Grid>
</Window>

