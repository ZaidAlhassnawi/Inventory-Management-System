<Page x:Class="InventoryManagementSystem_PresentaionLayer.Inventory_Logs.ViewInventoryLogs.InventoryLogsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InventoryManagementSystem_PresentaionLayer.Inventory_Logs.ViewInventoryLogs"
      mc:Ignorable="d" x:Name="InventoryLogs"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="{StaticResource Bg_Main}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Inventory Logs" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Text="Track all inventory movements and stock adjustments" Style="{StaticResource HeaderSubtitle}"/>
            </StackPanel>
            <Button Content="+ Add Adjustment" Style="{StaticResource PrimaryButtonStyle}"  HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding OpenAdjustStockWindowCommand}"/>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,30">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Total Logs" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="⚡" Foreground="#3498DB" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding TotalLogsCount}" FontWeight="Bold" FontSize="24"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Stock In" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="↗" Foreground="#27AE60" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StockInCount}" FontWeight="Bold" FontSize="24" Foreground="#27AE60"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Stock Out" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="↘" Foreground="#EB5757" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StockOutCount}" FontWeight="Bold" FontSize="24" Foreground="#EB5757"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Adjustments" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="✎" Foreground="#F2C94C" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="0" FontWeight="Bold" FontSize="24" Foreground="#F2994A"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Filters" FontWeight="Bold" Margin="0,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width=".5*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Tag="Search logs..."
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" >
                        <ComboBox Style="{StaticResource InputComboBoxStyle}" 
                                  ItemsSource="{Binding LogTypesList}"
                                  SelectedItem="{Binding SelectedLogType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock>
                        <Run Text="Inventory Logs (" FontWeight="Bold" FontSize="16"/>
                        <Run Text="{Binding TotalLogsCount}" FontWeight="Bold" FontSize="16"/>
                        <Run Text=")" FontWeight="Bold" FontSize="16"/>
                    </TextBlock>
                    <TextBlock Text="Complete history of all inventory movements" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>

                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding FilteredLogs}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True"
                          RowHeaderWidth="0"
                          GridLinesVisibility="None"
                          Foreground="#333"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FontSize="16"
                          FontWeight="Bold">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="SnapsToDevicePixels" Value="true"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="blue"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" 
                                                Background="Transparent" 
                                                BorderThickness="0">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="1.5*" FontWeight="Bold"/>

                        <DataGridTemplateColumn Header="Type" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BadgeColor}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⇋ " Foreground="White" FontSize="10"/>
                                            <TextBlock Text="{Binding LogType}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Quantity" Width="0.7*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding QuantityDisplay}" 
                               Foreground="{Binding QuantityColor}" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Previous Stock" Binding="{Binding PreviousStock}" Width="*"/>
                        <DataGridTextColumn Header="New Stock" Binding="{Binding NewStock}" Width="*"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="1.5*"/>
                        <DataGridTextColumn Header="User" Binding="{Binding FullName}" Width="*"/>

                        <DataGridTemplateColumn Header="Date" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📅 " Foreground="#999" FontSize="12" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding LogDate, StringFormat=MMM/dd/yyyy}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</Page>