<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#E9F0FF</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="PrimaryTextColor">#1A202C</Color>
    <Color x:Key="SecondaryTextColor">#718096</Color>
    <Color x:Key="InputBorderColor">#E2E8F0</Color>
    <Color x:Key="ButtonBackgroundColor">#1A1A1A</Color>
    <Color x:Key="LinkColor">#3B82F6</Color>
    <Color x:Key="IconBlue">#3B82F6</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="LinkBrush" Color="{StaticResource LinkColor}"/>

    <Color x:Key="Color_Primary">#4F46E5</Color>
    <Color x:Key="Color_Secondary">#64748B</Color>
    <Color x:Key="Color_Danger">#EF4444</Color>
    <SolidColorBrush x:Key="Bg_Main" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Bg_Sidebar" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg_Hover" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="Border_Light" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Text_Primary" Color="#1E293B"/>
    <SolidColorBrush x:Key="Text_Secondary" Color="#64748B"/>
    <SolidColorBrush x:Key="Text_Active" Color="#4F46E5"/>
    <SolidColorBrush x:Key="Text_Danger" Color="#EF4444"/>

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F2F4F8"/>
   
    <SolidColorBrush x:Key="AccentTextBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>

    <SolidColorBrush x:Key="ButtonBlackBrush" Color="#111827"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>

    <SolidColorBrush x:Key="PrimaryBlack" Color="#111827"/>
    <SolidColorBrush x:Key="TextGray" Color="#374151"/>
    <SolidColorBrush x:Key="LightBorder" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="FocusBlue" Color="#3B82F6"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>

</ResourceDictionary>