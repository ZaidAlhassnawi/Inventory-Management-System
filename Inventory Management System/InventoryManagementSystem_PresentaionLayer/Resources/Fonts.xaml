<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="Font_Main">Segoe UI</FontFamily>

    <sys:Double x:Key="Size_Small">11</sys:Double>
    <sys:Double x:Key="Size_Regular">14</sys:Double>
    <sys:Double x:Key="Size_Large">18</sys:Double>
    <sys:Double x:Key="Size_Header">22</sys:Double>

    <FontWeight x:Key="Weight_Regular">Normal</FontWeight>
    <FontWeight x:Key="Weight_Bold">SemiBold</FontWeight>
    <FontWeight x:Key="Weight_Heavy">Bold</FontWeight>

</ResourceDictionary>