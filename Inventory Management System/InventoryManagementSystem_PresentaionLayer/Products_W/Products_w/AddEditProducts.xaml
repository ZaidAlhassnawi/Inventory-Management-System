<Window x:Class="InventoryManagementSystem_PresentaionLayer.Products_W.Products_w.AddEditProducts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InventoryManagementSystem_PresentaionLayer.Products_W.Products_w"
        mc:Ignorable="d"
        Title="Add New Product" Height="680" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    
    <Border Background="White" CornerRadius="12" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2" Color="Black"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Add New Product" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBlack}"/>
                        <TextBlock Text="Fill in the details to add a new product to your inventory" FontSize="14" Foreground="#6B7280" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" FontSize="16" Cursor="Hand"/>
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                <StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SKU" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtSKU" Style="{StaticResource ModernInputStyle}" FontWeight="SemiBold" Foreground="#2563EB"
                                     Text="{Binding SKU, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Product Name" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtProductName" Style="{StaticResource ModernInputStyle}" Tag="Enter product name"
                                     Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
                            </TextBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Category" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Style="{StaticResource ModernComboBoxStyle}" Text="Select category" IsEditable="True" IsReadOnly="True"
                                      ItemsSource="{Binding CategoreyList}"
                                      DisplayMemberPath="CategoreName"
                                      SelectedValuePath="CategoryID"
                                      SelectedValue="{Binding CurrentProduct.CategoryID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Supplier" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Style="{StaticResource ModernComboBoxStyle}" Text="Select supplier" IsEditable="True" IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quantity" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="0" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cost Price" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="0" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Selling Price" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="0" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Image URL (optional)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="https://example.com/image.jpg" Style="{StaticResource ModernInputStyle}" Foreground="#6B7280"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Description" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="Product description..." Style="{StaticResource ModernInputStyle}" 
                                 Height="100" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Width="100"/>
                <Button Content="Add Product" Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
