<Page x:Class="InventoryManagementSystem_PresentaionLayer.Products_W.Product_w1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InventoryManagementSystem_PresentaionLayer.Products_W"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="{StaticResource Bg_Main}">


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <Grid Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="Products" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="Manage your product inventory and stock levels" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="+ Add Product" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding OpenAddProductWindowCommand}"/>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Products" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="📦" FontSize="24" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="3" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Low Stock" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="⚠" FontSize="24" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="1" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Out of Stock" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="🚫" FontSize="24" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Height="100" Style="{StaticResource CardStyle}" Padding="15">
                <Grid Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Filters" FontSize="18" FontWeight="Bold" VerticalAlignment="Top" Margin="0,-25,0,0" Grid.ColumnSpan="2"/>

                    <Border Height="40" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5">
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#9CA3AF" Width="170"/>
                            <TextBlock Text=" Search products..." Margin="33 0 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#9CA3AF" Width="170"/>
                            <TextBox Grid.Column="0" Width="auto" Height="28" Padding="33 4 0 0" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Foreground="#6B7280" Margin="0,2,0,0"/>
                        </Grid>
                    </Border>

                    <ComboBox Style="{StaticResource InputComboBoxStyle}" Grid.Column="3" Width="150" Padding="10,5" SelectedIndex="0">
                        <ComboBoxItem Content="All Categories"/>
                    </ComboBox>
                    <ComboBox Style="{StaticResource InputComboBoxStyle}" Grid.Column="5" Width="150" Padding="10,5" SelectedIndex="0">
                        <ComboBoxItem Content="All Stock"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="3">
                <StackPanel>
                    <TextBlock Text="Products (3)" Margin="20,20,0,5" FontWeight="Bold"/>
                    <TextBlock Text="List of all products in your inventory" Margin="20,0,0,20" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>

                    <DataGrid AutoGenerateColumns="False" BorderThickness="0" Background="White" RowHeaderWidth="0" 
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6"
                              RowHeight="60" Padding="10">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Product" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="10,0">
                                            <Border Width="40" Height="40" CornerRadius="4" Background="#F3F4F6" Margin="0,0,10,0">
                                                <TextBlock Text="📷" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#6B7280"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="1.5*"/>

                            <DataGridTemplateColumn Header="Stock" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Black" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Stock}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Cost Price" Binding="{Binding CostPrice}" Width="*"/>
                            <DataGridTextColumn Header="Selling Price" Binding="{Binding SellingPrice}" Width="*"/>

                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="✏" Width="30" Height="30" Margin="0,0,5,0" Background="Transparent" BorderBrush="#E5E7EB" BorderThickness="1"/>
                                            <Button Content="🗑" Width="30" Height="30" Background="Transparent" BorderBrush="#E5E7EB" BorderThickness="1"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
