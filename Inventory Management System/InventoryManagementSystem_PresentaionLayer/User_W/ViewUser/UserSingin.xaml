<Page x:Class="InventoryManagementSystem_PresentaionLayer.ViewUser.UserSingin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InventoryManagementSystem_PresentaionLayer.ViewUser"
      mc:Ignorable="d" 
      x:Name="LoginWindow"
       d:DesignHeight="428" d:DesignWidth="458" Background="{StaticResource WindowBackgroundBrush}" >
    
    

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">

            <Border Background="White" CornerRadius="12" Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Color="#CBD5E0" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Sign In" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Enter your credentials to access your account" FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,25"/>

                    <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CurrentUser.Email, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True}"
                             Style="{StaticResource InputTextBoxStyle}" Margin="0 0 0 25"/>

                    <TextBlock Text="Password" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox x:Name="UserPasswordBox" Style="{StaticResource InputBoxStyle}" Margin="0 0 0 10"/>

                    <Button Command="{Binding LoginCommand}" 
                            CommandParameter="{Binding ElementName=UserPasswordBox}" 
                            Content="Sign In" Style="{StaticResource SignUpButtonStyle}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="Don't have an account? " Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="Sign up" Foreground="{StaticResource LinkBrush}" Cursor="Hand" FontWeight="SemiBold">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding OpenSignupCommand}"
                                              CommandParameter="{Binding ElementName=LoginWindow}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
