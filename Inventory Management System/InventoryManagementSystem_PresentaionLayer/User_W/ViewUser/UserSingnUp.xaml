<Page x:Class="InventoryManagementSystem_PresentaionLayer.User.ViewUser.UserSingnUp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:InventoryManagementSystem_PresentaionLayer.ViewUser"
      mc:Ignorable="d" 
      d:DesignHeight="685" d:DesignWidth="470" x:Name="SignupWindow"
     Background="{StaticResource WindowBackgroundBrush}" >

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450" Grid.ColumnSpan="2" Margin="4,0,0,0">

            <Border Background="White" CornerRadius="12" Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Color="#CBD5E0" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Sign Up" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Create a new account to access the inventory system" FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,15"/>

                    <TextBlock Text="Full Name" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtName" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                             Style="{StaticResource InputTextBoxStyle}"/>
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=TxtName}"
                                Foreground="Red" FontSize="12" Margin="0,2,0,10"/>

                    <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=TxtEmail}"
               Foreground="Red" 
               FontSize="12" 
               Margin="0,2,0,0">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding (Validation.HasError), ElementName=TxtEmail}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Role" Style="{StaticResource LabelStyle}"/>
                    <ComboBox  Style="{StaticResource InputComboBoxStyle}"
                               SelectedValuePath="Tag" SelectedValue="{Binding RoleId, Mode=TwoWay}">
                        <ComboBoxItem Content="Admin" Tag="1"/>
                        <ComboBoxItem Content="Manager" Tag="2"/>
                        <ComboBoxItem Content="Staff" Tag="3"/>
                    </ComboBox>

                    <TextBlock Text="Password" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox Style="{StaticResource InputBoxStyle}"
                                 x:Name="TxtPass" Tag="{Binding Password, Mode=OneWay, ValidatesOnNotifyDataErrors=True}"
                                 PasswordChanged="TxtPass_PasswordChanged"/>
                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=TxtPass}"
                                Foreground="Red" FontSize="12" Margin="0,2,0,0"/>

                    <TextBlock Text="Confirm Password" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox Style="{StaticResource InputBoxStyle}" x:Name="TxtConfirm"
                            Tag="{Binding ConfirmPassword, Mode=OneWay, ValidatesOnNotifyDataErrors=True}"
                            PasswordChanged="TxtConfirm_PasswordChanged"
                            Padding="5"/>

                    <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=TxtConfirm}"
                                Foreground="Red" FontSize="12" Margin="0,2,0,0"/>

                    <Button Content="Sign Up" Style="{StaticResource SignUpButtonStyle}"
                            Command="{Binding SignUpCommand}" 
                            CommandParameter="{Binding ElementName=TxtPass}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="Already have an account? " Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="Sign in" Foreground="{StaticResource LinkBrush}" Cursor="Hand" FontWeight="SemiBold">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding OpenSignInCommand}"
                                              CommandParameter="{Binding ElementName=SignupWindow}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
