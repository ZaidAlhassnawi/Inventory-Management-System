<Window x:Class="InventoryManagementSystem_PresentaionLayer.ViewUser.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InventoryManagementSystem_PresentaionLayer.ViewUser"
        mc:Ignorable="d"
        Title="UserWindow" Height="1000" Width="900" AllowsTransparency="True" WindowStyle="None" 
        WindowStartupLocation="CenterScreen" Background="Transparent" Loaded="Window_Loaded">

    <Border CornerRadius="25" Background="#E9F0FF" MouseDown="Border_MouseDown"  >

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="600"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="2.5*"/>
                <RowDefinition Height="0.3*"/>
            </Grid.RowDefinitions>


            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,10,0,0">
                <Path Data="M12,3L2,12L12,21L22,12L12,3M12,5L19,12L12,19L5,12L12,5Z" 
                      Fill="#3B82F6" Width="50" Height="50" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="Inventory System" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Create your account to get started" FontSize="18" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Column="1" Grid.Row="1">
                <Frame x:Name="MainFrame" Padding="10" Margin="10" NavigationUIVisibility="Hidden" Width="auto" Height="auto"/>
            </Grid>

        </Grid>
        
    </Border>

</Window>
